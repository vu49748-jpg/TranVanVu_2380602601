APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
SECRET_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARACTERS

# Recommended demo transport: Gmail through Google Apps Script HTTPS endpoint.
EMAIL_TRANSPORT=apps_script
GAS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
GAS_SHARED_SECRET=REPLACE_WITH_THE_SAME_RANDOM_VALUE_AS_OTP_SHARED_SECRET

# First deployment only. Delete ADMIN_PASSWORD from service env after first startup.
ADMIN_USERNAME=tranvanvu
ADMIN_EMAIL=YOUR_REAL_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Optional alternatives: EMAIL_TRANSPORT=resend or smtp.
# Resend requires an authorized sender; sandbox can only send to the account owner.
# RESEND_API_KEY=
# MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Free Render blocks outbound SMTP ports; use HTTPS transport there.
